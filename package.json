{
  "name": "@abc12524/dsh-openviking",
  "description": "OpenViking memory integration: Web Settings plugin card + automatic memory-context injection",
  "version": "0.1.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "openviking",
    "memory",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abc12524/dsh-openviking.git"
  },
  "homepage": "https://github.com/abc12524/dsh-openviking#readme",
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.json && tsdown --env.DSH_BUILD_FACE client",
    "build": "tsc -p tsconfig.json && tsdown",
    "prepare": "node scripts/prepare.mjs"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "patches"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "react": "^18.2.0"
  }
}
